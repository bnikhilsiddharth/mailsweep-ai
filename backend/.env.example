# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/mailsweep

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Session & Security
SESSION_SECRET=change_this_to_a_long_random_string_in_production
ENCRYPTION_KEY=change_this_32_char_key_in_prod!!

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# AI (optional - enables AI Copilot and weekly report generation)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Logging
LOG_LEVEL=info
